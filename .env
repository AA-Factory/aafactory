# Environment variables for the backend service
CELERY_BROKER_URL=redis://${RUNPOD_ENDPOINT:-redis:6379}/0
CELERY_RESULT_BACKEND=redis://${RUNPOD_ENDPOINT:-redis:6379}/0
ZONOS_SERVER_TAG=1.0.3
INFINITE_TALK_SERVER_TAG=1.0.0

# Environment variables for the frontend service
MONGODB_URI=mongodb://admin:password@mongodb:27017/myapp?authSource=admin
NEXT_PUBLIC_CELERY_BASE_URL=http://0.0.0.0:8000
NEXT_PUBLIC_CELERY_BASE_URL_SERVER=http://host.docker.internal:8000
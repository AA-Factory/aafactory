{
  "name": "aafactory-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest",
    "test:unit:watch": "vitest --watch",
    "test:hooks": "vitest run -c vitest.config.hooks.ts",
    "test:hooks:watch": "vitest watch -c vitest.config.hooks.ts",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed --project=chromium",
    "test:e2e:debug": "playwright test --debug --project=chromium",
    "test:e2e:report": "playwright show-report",
    "test:e2e:codegen": "playwright codegen http://localhost:3000",
    "db:seed": "node scripts/seed-db.js",
    "db:seed:clear": "node scripts/seed-db.js --clear"
  },
  "browser": {
    "fs": false,
    "path": false,
    "os": false
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.6",
    "@ffmpeg/util": "^0.12.1",
    "@happy-dom/jest-environment": "^20.0.10",
    "@hookform/resolvers": "^5.2.1",
    "@tailwindcss/postcss": "^4.1.10",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-query-devtools": "^5.83.0",
    "@testing-library/react": "^16.3.0",
    "@types/fabric": "^5.3.3",
    "@types/react": "18.2.14",
    "@types/react-dom": "18.2.6",
    "@vitejs/plugin-react": "^5.1.0",
    "animejs": "^3.2.1",
    "clsx": "^2.1.1",
    "eslint-config-next": "^15.5.6",
    "fabric": "^5.3.0",
    "mobx": "^6.9.0",
    "mobx-react-lite": "^4.1.1",
    "mongodb": "^6.18.0",
    "next": "^15.5.6",
    "postcss": "8.4.25",
    "react": "^19.2.0",
    "react-color": "^2.19.3",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.62.0",
    "react-icons": "^4.10.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.10",
    "typescript": "5.1.6",
    "usehooks-ts": "^3.1.1",
    "uuid": "^11.1.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/animejs": "^3.1.7",
    "@types/node": "^24.9.2",
    "@types/react-color": "^3.0.6",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-unused-imports": "^4.2.0",
    "prettier": "^3.6.2",
    "vitest": "^4.0.6"
  }
}
# Build argument to control environment
ARG NODE_ENV=production
ARG NEXT_PUBLIC_CELERY_BASE_URL
ARG NEXT_PUBLIC_RUNPOD_ENDPOINT
ARG NEXT_PUBLIC_CELERY_BASE_URL_SERVER

FROM node:18-alpine AS deps
WORKDIR /app
COPY package*.json package-lock.json ./
RUN npm ci

FROM node:18-alpine AS builder

ARG NODE_ENV
ARG NEXT_PUBLIC_CELERY_BASE_URL
ARG NEXT_PUBLIC_RUNPOD_ENDPOINT
ARG NEXT_PUBLIC_CELERY_BASE_URL_SERVER

ENV NODE_ENV=${NODE_ENV}
ENV NEXT_PUBLIC_CELERY_BASE_URL=${NEXT_PUBLIC_CELERY_BASE_URL}
ENV NEXT_PUBLIC_RUNPOD_ENDPOINT=${NEXT_PUBLIC_RUNPOD_ENDPOINT}
ENV NEXT_PUBLIC_CELERY_BASE_URL_SERVER=${NEXT_PUBLIC_CELERY_BASE_URL_SERVER}

WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:18-alpine AS runner
WORKDIR /app

# Install wait-port, Docker CLI and docker-compose
RUN npm install -g wait-port
RUN apk add --no-cache docker-cli docker-compose

# Create docker group with host's docker GID (typically 999 or 998)
RUN addgroup -g 999 docker 2>/dev/null || true

RUN addgroup --system --gid 1001 nodejs || true
RUN adduser --system --uid 1001 nextjs || true
# Add nextjs user to docker group for socket access
RUN adduser nextjs docker || true

# CRITICAL: Copy public folder BEFORE standalone
COPY --from=builder /app/public ./public

# Copy standalone output
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder /app/scripts ./scripts
COPY --from=builder /app/schemas ./schemas

RUN mkdir -p /data/uploads && chown -R nextjs:nodejs /data/uploads
# RUN if [ -d "public/uploads" ]; then \
#       cp -r public/uploads/* /data/uploads/ 2>/dev/null || true; \
#     fi

USER nextjs


EXPOSE 3000

# Production: node server.js (standalone), Development: npm run dev
CMD sh -c "wait-port mongodb:27017 && node scripts/db-setup.js && node server.js"
